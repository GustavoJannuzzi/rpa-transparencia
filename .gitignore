# Ambiente Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Estado, cache, originais e evidências do robô: ficam na máquina que coleta.
# Os originais (PDFs, páginas, respostas) trazem nome de servidor público; o
# repositório só guarda as amostras anonimizadas dos testes.
/dados/

# Plataforma
plataforma/node_modules/
plataforma/.next/
plataforma/out/
plataforma/next-env.d.ts
plataforma/*.tsbuildinfo

# Segredos
.env
.env.*

# Sistema
.DS_Store
Thumbs.db

# Testes de navegador da plataforma (relatórios e resultados de cada rodada)
plataforma/testes/resultados/
plataforma/testes/relatorio-playwright/
plataforma/testes/lighthouse/
plataforma/.lighthouseci/
